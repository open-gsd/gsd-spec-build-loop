#!/bin/sh
set -eu

printf '%s\n' "$*" >> "$NPM_LOG"

if [ "${1:-}" = view ]; then
  case "${MOCK_NPM_VIEW_RESULT:-missing}" in
    exists)
      printf '{"version":"%s","gitHead":"%s"}\n' \
        "${MOCK_PACKAGE_VERSION:-0.2.5}" \
        "${MOCK_NPM_GIT_HEAD:-0123456789abcdef0123456789abcdef01234567}"
      ;;
    missing)
      echo "npm error code E404" >&2
      exit 1
      ;;
    error)
      echo "npm error code E500" >&2
      exit 1
      ;;
    *)
      exit 1
      ;;
  esac
fi
